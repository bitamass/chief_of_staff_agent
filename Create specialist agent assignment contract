{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specialist Agent Response",
  "type": "object",
  "required": [
    "assignment_id",
    "agent",
    "status",
    "executive_summary",
    "recommendation",
    "confidence"
  ],
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": [
        "innovation-agent",
        "compliance-agent",
        "project-management-agent",
        "data-analyst-agent"
      ]
    },
    "skills_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "needs-information",
        "blocked",
        "escalation-required"
      ]
    },
    "executive_summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string"
    },
    "decisions_needed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "owner"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "due_date": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
